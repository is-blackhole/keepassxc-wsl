{
  "name": "keepassxc-wsl",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=20.12"
  },
  "description": "CLI for KeePassXC via browser integration (WSL → Windows)",
  "keywords": [
    "keepassxc",
    "wsl",
    "cli",
    "password-manager",
    "typescript"
  ],
  "homepage": "https://github.com/is-blackhole/keepassxc-wsl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/is-blackhole/keepassxc-wsl.git"
  },
  "bugs": {
    "url": "https://github.com/is-blackhole/keepassxc-wsl/issues"
  },
  "bin": {
    "kpx": "dist/bin.js"
  },
  "files": [
    "dist",
    "completions"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "kpx": "node dist/bin.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "author": "Igor Sazhnev <igor.sazhnev@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
